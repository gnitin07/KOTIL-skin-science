# .htaccess is parsed by Apache/LiteSpeed on Linux. Checked out with Windows
# CRLF endings it can fail in ways that are hard to read — a stray \r rides
# along on the last token of a line, so a 301 target becomes "/#treatments\r".
# Force LF so what Hostinger parses matches what is written here.
public/.htaccess text eol=lf

raw-assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.png filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.mov filter=lfs diff=lfs merge=lfs -text
raw-assets/**/*.webm filter=lfs diff=lfs merge=lfs -text
